<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources required to restore/update this solution.

  Most packages come from nuget.org, but the Avalonia packages are pinned to
  prerelease CI builds (see Avalonia.props -> <AvaloniaVersion>) and
  Avalonia.Xaml.Behaviors is pinned to 11.1.0-beta1. Those prerelease builds are
  NOT published to nuget.org, they only exist on the feeds below.

  These feeds must be declared in NuGet.config (and not only via the
  RestoreAdditionalProjectSources MSBuild property in Directory.Build.props),
  otherwise `dotnet restore` can find them but the NuGet Package Manager UI,
  "Manage NuGet Packages for Solution" and `dotnet list package --outdated`
  cannot see them, and packages appear to be un-restorable / un-updatable.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Avalonia CI (nightly) feed - hosts 11.3.999-cibuild00XXXXX-alpha builds -->
    <add key="Avalonia CI" value="https://nuget-feed-all.avaloniaui.net/v3/index.json" />
    <!-- Hosts Avalonia.Xaml.Behaviors 11.1.0-beta1 -->
    <add key="XamlBehaviors Nightly" value="https://www.myget.org/F/xamlbehaviors-nightly/api/v3/index.json" />
  </packageSources>
</configuration>
